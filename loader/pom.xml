<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.dremo_drizzy</groupId>
        <artifactId>bus-truth</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>loader</artifactId>
    <packaging>jar</packaging>

    <name>loader</name>
    <description>Consumes the Kafka topics and writes them idempotently to the Postgres raw tables</description>

    <dependencies>
        <!-- Spring MVC + embedded Tomcat. Needed so /actuator/health is served over
             HTTP; actuator on its own brings no web server. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- JUnit 5, AssertJ, Mockito and Spring's test support. Test scope: on the
             classpath for `mvn test`, left out of the packaged app jar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Repackages the jar into an executable fat jar (java -jar loader.jar).
                 Right for an app; the reason common does NOT declare it. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
