# --- Java / Maven ---------------------------------------------------------
# Build output. Unanchored on purpose: matches collector/target/, api/target/,
# and dbt's analytics/target/ too.
target/
*.class
*.log
hs_err_pid*
# Maven release/versions plugin leftovers
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
release.properties
# The wrapper is committed (mvnw, mvnw.cmd, .mvn/wrapper/*.properties);
# only its downloaded jar, if a script ever fetches one, is not.
.mvn/wrapper/maven-wrapper.jar

# --- Node / Vite (web/) -----------------------------------------------------
node_modules/
# Vite's build output. Derived from src/ by `npm run build`, so committing it would
# mean two sources of truth for what the site is, and the one in git would be stale
# the moment anybody edited a component.
dist/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
# Playwright's output: screenshots, traces and the HTML report. Regenerated by every
# run and uploaded as a CI artifact, so there is nothing to keep in git.
test-results/
playwright-report/
playwright/.cache/

# --- Python (scripts/, gtfs-loader) ---------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- dbt (analytics/) -------------------------------------------------------
dbt_packages/
logs/

# --- IDEs and OS --------------------------------------------------------------
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
.factorypath
.DS_Store
Thumbs.db

# --- Secrets ------------------------------------------------------------------
# Real config lives in .env and never gets committed; .env.example is the
# committed template with placeholders only.
.env
.env.*
!.env.example
# One exception, and it is not a secret: Vite reads build-time configuration from
# .env.<mode> files, and web/.env.snapshot holds the single flag that makes the map
# draw a named historical minute instead of watching a live feed. It has to be
# committed or CI builds the wrong page — which is exactly what happened, and CI is
# what caught it. The .env.* rule above still covers anything that does hold a secret.
!web/.env.snapshot
# Local-only Spring profile, holding the development database password. The
# committed application.yml gives that property no default on purpose.
application-local.yml

# --- Data -------------------------------------------------------------------
# Captured feeds and local database dumps. Anchored to the repo root so it
# can't accidentally hide a source folder named data/ deeper in the tree.
/data/
# The collector's own scratch archive. Unanchored, because a relative
# archive-dir lands under whichever module the process was started from.
dev-archive/
