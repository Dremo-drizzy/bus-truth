# Build-time configuration for `vite build --mode snapshot`.
#
# Only for local builds and the browser test suite. The hosted site does not use this
# file: Render injects the same variable from render.yaml, which is the single place the
# deployment's configuration lives.
#
# Vite's own --mode is used rather than an inline environment variable because
# `VITE_MAP_MODE=snapshot npm run build` does not work when npm runs scripts through
# cmd on Windows, and a cross-platform shim would be a new dependency for one line.
VITE_MAP_MODE=snapshot
