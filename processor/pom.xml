<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.dremo_drizzy</groupId>
        <artifactId>bus-truth</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>processor</artifactId>
    <packaging>jar</packaging>

    <name>processor</name>
    <description>Turns raw positions and trip updates into arrival_events, re-runnable per date range</description>

    <dependencies>
        <!-- The shared records: the processor reads VehiclePosition and writes
             ArrivalEvent, both agreed in one place. -->
        <dependency>
            <groupId>io.github.dremo_drizzy</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- JdbcClient and a pool. The processor reads raw_vehicle_positions and
             writes arrival_events; the collector owns the schema. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring MVC + embedded Tomcat. Needed so /actuator/health is served over
             HTTP; actuator on its own brings no web server. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- JUnit 5, AssertJ, Mockito and Spring's test support. Test scope: on the
             classpath for `mvn test`, left out of the packaged app jar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- A real PostgreSQL 18 for the re-run test: deleting a date range and
             reinserting it is SQL behaviour, not Java behaviour. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Surefire runs *Test and ignores *IT, so failsafe has to be bound or
                 the re-run proof would silently never run. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Repackages the jar into an executable fat jar (java -jar processor.jar).
                 Right for an app; the reason common does NOT declare it. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
