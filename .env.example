# Copy to .env and fill in real values. .env is git-ignored; this file is not,
# so it must only ever contain placeholders.

# PostgreSQL. The names match what the official postgres Docker image reads
# on first start to create the user and database.
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=change-me

# Where the database is. Both have local defaults in each module's application.yml,
# so development needs neither: localhost:55432, which is the port infra's compose
# file publishes. Production sets them to the service name on the private network
# (POSTGRES_HOST=postgres, POSTGRES_PORT=5432), or to a managed instance's host.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
